{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-applied-migration.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "마이그레이션 보호 검사"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-env-read.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": ".env 보호 검사"
          }
        ]
      }
    ]
  }
}
